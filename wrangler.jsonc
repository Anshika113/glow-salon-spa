{
  "name": "glow-salon-spa",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glow-salon-spa",
      "database_id": "b18c1d46-862d-441b-8078-ddc6ff30530b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
